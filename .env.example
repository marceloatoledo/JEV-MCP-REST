# Copie para .env e preencha. Docker Compose e produção leem este arquivo.
# Não commite o .env.
#
# Desenvolvimento local (`dotnet run`, ambiente Development): use
# src/JevMcp.App/appsettings.Development.json (mesmas chaves em MAIÚSCULAS).
# O processo não carrega .env automaticamente.
#
# Chaves em MAIÚSCULAS: __ no env espelha : no JSON / bind ASP.NET.

# -----------------------------------------------------------------------------
# Acesso ao /mcp, à API REST e ao admin
# -----------------------------------------------------------------------------
# Login do admin. Obrigatório para entrar na UI (Docker em 0.0.0.0).
ACCESSCONTROL__USERNAME=
ACCESSCONTROL__PASSWORD=
# Alias legado: JEVMCP_ADMIN_USERNAME / JEVMCP_ADMIN_PASSWORD

# Libera /mcp e /api/jev sem Bearer. Desligado por padrão; não use em produção.
# ACCESSCONTROL__ALLOWANONYMOUSMCP=false

# -----------------------------------------------------------------------------
# Provedor Jev — detecção automática quando JEV__PROVIDER=auto (ou ausente):
# TypeSafe → OpenRouter → Cloudflare → Vercel → compatible.
# Preencha só o que for usar. Chaves vazias não entram no processo.
# -----------------------------------------------------------------------------
# auto | typesafe | openrouter | cloudflare | vercel | compatible
JEV__PROVIDER=auto
# Alias jev-mcp: JEV_PROVIDER

JEV__MCP__MODEL=jev-latest
# Alias jev-mcp: JEV_MCP_MODEL

# TypeSafe (recomendado)
TYPESAFE__API__KEY=
# Só a origem, sem /v1/systemone. Padrão: https://api.typesafe.ai
# TYPESAFE__BASEURL=https://api.typesafe.ai
# Aliases jev-mcp: TYPESAFE_API_KEY, JEV_TYPESAFE_API_KEY, TYPESAFE_BASE_URL

# OpenRouter — a chave só conta se começar com sk-or-
OPENROUTER__API__KEY=
# Aliases jev-mcp: OPENROUTER_API_KEY, JEV_OPENROUTER_API_KEY

# Cloudflare Workers AI
CLOUDFLARE__API__TOKEN=
CLOUDFLARE__ACCOUNT__ID=
# Aliases jev-mcp: CLOUDFLARE_API_TOKEN, JEV_CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, JEV_CLOUDFLARE_ACCOUNT_ID

# Vercel AI Gateway
AIGATEWAY__API__KEY=
# AIGATEWAY__BASEURL=https://ai-gateway.vercel.sh/v4/ai
# Aliases jev-mcp: AI_GATEWAY_API_KEY, JEV_AI_GATEWAY_API_KEY, AI_GATEWAY_BASE_URL

# Endpoint compatível — URL completa de POST, usada verbatim
COMPATIBLE__API__KEY=
COMPATIBLE__BASEURL=
# Aliases jev-mcp: JEV_API_KEY, JEV_API_BASE_URL

# -----------------------------------------------------------------------------
# Auditoria SQLite — no Docker Compose o banco fica em ./data/jevmcp.db no host
# (montado em /app/data/jevmcp.db no container; não é apagado por rebuild da imagem).
# -----------------------------------------------------------------------------
# CALLAUDIT__DATABASEPATH=data/jevmcp.db
# CALLAUDIT__CAPTUREPAYLOADS=false
# CALLAUDIT__PAYLOADMAXCHARS=4096
# CALLAUDIT__RETENTIONDAYS=30

# -----------------------------------------------------------------------------
# Compose — só interpolação do docker-compose.yml, não é lida pela aplicação
# -----------------------------------------------------------------------------
# JEVMCP_HOST_PORT=10022
