@inject IJSRuntime JS
@inject ThemeState Theme
@implements IAsyncDisposable

<div @ref="_host" class="echarts-host" style="@($"height:{Height}px")" data-chart="@Kind"></div>

@code {
    [Parameter]
    public string Kind { get; set; } = "";

    [Parameter]
    public string OptionJson { get; set; } = "{}";

    [Parameter]
    public int Height { get; set; } = 300;

    [Parameter]
    public EventCallback<ChartHit> Hit { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DashboardChart>? _self;
    private string? _applied;
    private bool _repaint;
    private bool _disposed;

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/dashboard-charts.js");
                await _module.InvokeVoidAsync("bind", _host, _self);
            }

            if (_module is null)
            {
                return;
            }

            if (_applied != OptionJson)
            {
                _applied = OptionJson;
                _repaint = false;
                await _module.InvokeVoidAsync("setOption", _host, OptionJson);
            }
            else if (_repaint)
            {
                // Only here are the MudBlazor CSS variables already those of the new theme.
                _repaint = false;
                await _module.InvokeVoidAsync("refresh", _host);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task OnChartHit(string json)
    {
        return Hit.InvokeAsync(ChartHit.Parse(json));
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Theme.Changed -= OnThemeChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _host);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }

            _module = null;
        }

        _self?.Dispose();
    }

    private void OnThemeChanged()
    {
        if (_disposed)
        {
            return;
        }

        _repaint = true;
        _ = InvokeAsync(StateHasChanged);
    }
}
