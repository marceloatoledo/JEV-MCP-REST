@inject NavigationManager Nav
@using System.Globalization

<form method="post" action="/api/culture" class="culture-form" aria-label="@L["Language"]">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnPath" />
    <label class="culture-select-label" for="jev-culture">@L["Language"]</label>
    <select id="jev-culture" name="culture" class="culture-select"
            onchange="this.form.requestSubmit()">
        <option value="pt-BR" selected="@Selected("pt-BR")">@L["LanguageOptionPt"]</option>
        <option value="en" selected="@Selected("en")">@L["LanguageOptionEn"]</option>
        <option value="es" selected="@Selected("es")">@L["LanguageOptionEs"]</option>
    </select>
</form>

@code {
    private static string CurrentCultureCode =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch
        {
            "pt" => "pt-BR",
            "en" => "en",
            "es" => "es",
            _ => UiCultures.Default,
        };

    private string ReturnPath
    {
        get
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            return string.IsNullOrEmpty(uri.Query) ? uri.AbsolutePath : uri.PathAndQuery;
        }
    }

    private static bool Selected(string code) =>
        string.Equals(CurrentCultureCode, code, StringComparison.OrdinalIgnoreCase);
}
