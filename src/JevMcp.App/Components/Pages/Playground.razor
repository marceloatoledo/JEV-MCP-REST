@page "/playground"
@attribute [Authorize]
@inject ICallAudit CallAudit
@inject AuthenticationStateProvider Auth
@inject VerifyService Verify
@inject ScreenService Screen
@inject FindService Find
@inject ClassifyService Classify
@inject DecideService Decide
@inject RerankService Rerank
@inject CompareService Compare
@inject ExtractService Extract
@inject ReviewService Review
@inject GateService Gate

<PageTitle>@L["PlaygroundTitle"]</PageTitle>

<MudText Typo="Typo.h5">@L["PlaygroundTitle"]</MudText>
<MudText Typo="Typo.body2" Class="mt-2 mb-4">
    @L["PlaygroundHelp"]
</MudText>

<MudSelect Variant="Variant.Filled" T="string" Label="@L["Tool"]" @bind-Value="_tool" Class="mb-4" Style="max-width:24rem">
    @foreach (var tool in ToolNames)
    {
        <MudSelectItem Value="tool">@tool</MudSelectItem>
    }
</MudSelect>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.subtitle2">@L["PlaygroundSampleData"]</MudText>
        <PlaygroundToolExampleHelp Tool="@_tool" />
    </MudStack>
    @if (_tool == JevTools.Screen)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_text" Label="text" Lines="6" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_purpose" Label="purpose" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_blockAt" Label="block_at" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_reviewAt" Label="review_at" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }
    else if (_tool == JevTools.Verify)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_claims" Label="@L["FieldClaimsLines"]" Lines="4" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_evidence" Label="@L["FieldEvidenceJson"]" Lines="4" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_autoAccept" Label="auto_accept" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }
    else if (_tool == JevTools.Find || _tool == JevTools.Rerank)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_query" Label="query" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_candidates" Label="@L["FieldCandidatesJson"]" Lines="6" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="int" @bind-Value="_topK" Label="top_k" Class="mt-3" Min="1" Max="50" />
    }
    else if (_tool == JevTools.Classify)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_items" Label="@L["FieldItemsJson"]" Lines="4" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_classes" Label="@L["FieldClassesJson"]" Lines="4" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_purpose" Label="purpose" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_autoAccept" Label="auto_accept" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_minimumMargin" Label="minimum_margin" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }
    else if (_tool == JevTools.Decide)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_decision" Label="decision" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_evidenceText" Label="evidence" Lines="4" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_priorities" Label="priorities" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_decideCandidates" Label="@L["FieldCandidatesJson"]" Lines="4" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_requirements" Label="@L["FieldRequirementsLines"]" Lines="3" Class="mt-3" />
    }
    else if (_tool == JevTools.Compare)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_passageA" Label="passage_a" Lines="4" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_passageB" Label="passage_b" Lines="4" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_aspects" Label="@L["FieldAspectsLines"]" Lines="3" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_purpose" Label="purpose" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_autoAccept" Label="auto_accept" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_minimumMargin" Label="minimum_margin" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }
    else if (_tool == JevTools.Extract)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_document" Label="document" Lines="6" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_fields" Label="@L["FieldFieldsJson"]" Lines="10" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_extractPurpose" Label="purpose" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_autoAccept" Label="auto_accept" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_minimumMargin" Label="minimum_margin" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }
    else if (_tool == JevTools.Review)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_request" Label="request" Lines="3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_diff" Label="diff" Lines="8" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_tests" Label="tests" Lines="3" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_autoAccept" Label="auto_accept" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_reviewAt" Label="review_at" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_compositeFloor" Label="composite_floor" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }
    else if (_tool == JevTools.Gate)
    {
        <MudTextField Variant="Variant.Filled" @bind-Value="_request" Label="request" Lines="3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_diff" Label="diff" Lines="6" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_claims" Label="@L["FieldClaimsLines"]" Lines="3" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_evidence" Label="@L["FieldEvidenceJson"]" Lines="4" Class="mt-3" />
        <MudTextField Variant="Variant.Filled" @bind-Value="_tests" Label="tests" Lines="3" Class="mt-3" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_autoAccept" Label="auto_accept" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_reviewAt" Label="review_at" Class="mt-3" Min="0" Max="1" Step="0.05" />
        <MudNumericField Variant="Variant.Filled" T="double" @bind-Value="_compositeFloor" Label="composite_floor" Class="mt-3" Min="0" Max="1" Step="0.05" />
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="_busy" OnClick="RunAsync">
        @L["Run"]
    </MudButton>
</MudPaper>

@if (_outcome is { } outcome)
{
    <MudAlert Severity="@(outcome.Failed ? Severity.Error : Severity.Success)" Variant="Variant.Filled" Class="mb-4">
        @L[outcome.Headline ?? "PlaygroundResult"]
        @if (!string.IsNullOrEmpty(outcome.Action))
        {
            <span> @L["PlaygroundAction", outcome.Action]</span>
        }
    </MudAlert>
    <MudPaper Class="pa-4" Outlined="true">
        <pre style="white-space:pre-wrap">@outcome.Json</pre>
    </MudPaper>
}

@code {
    private static readonly string[] ToolNames =
    [
        JevTools.Extract, JevTools.Screen, JevTools.Verify, JevTools.Find, JevTools.Classify,
        JevTools.Decide, JevTools.Rerank, JevTools.Compare, JevTools.Review, JevTools.Gate,
    ];

    private string _tool = JevTools.Extract;
    private bool _busy;
    private PlaygroundOutcome? _outcome;

    private string _text = "A paragraph of ordinary documentation.";
    private string _purpose = "";
    private double _blockAt = ScreenService.DefaultBlockAt;
    private double _reviewAt = ScreenService.DefaultReviewAt;
    private double _autoAccept = 0.8;
    private double _minimumMargin = ClassifyService.DefaultMinimumMargin;
    private double _compositeFloor = 0.5;
    private string _claims = "The sky is blue.";
    private string _evidence = "\"The sky appears blue during the day.\"";
    private string _query = "authentication";
    private string _candidates = """[{"id":"a","text":"Login uses cookies."},{"id":"b","text":"The office has three floors."}]""";
    private int _topK = FindService.DefaultTopK;
    private string _items = """[{"id":"1","text":"Reset the password by email."}]""";
    private string _classes = """[{"id":"auth","description":"Authentication and credentials"},{"id":"other","description":"Anything else"}]""";
    private string _decision = "Which option should we ship?";
    private string _evidenceText = "Option A is cheaper. Option B is safer.";
    private string _priorities = "Prefer safety over cost.";
    private string _decideCandidates = """[{"id":"a","description":"Ship A"},{"id":"b","description":"Ship B"}]""";
    private string _requirements = "";
    private string _passageA = "The service retries three times.";
    private string _passageB = "The service does not retry.";
    private string _aspects = "";
    private string _document = """
INVOICE #INV-2024-0842
Bill To: Acme Corp (billing@acme.example)
Issued: 2024-11-05

Subtotal: USD 1,240.00
Tax (8%): USD 99.20
Total due: USD 1,339.20

Budget note: prior quote capped at USD 1,200.00 — not the billed amount.
Payment reference: REF-8842-ACME
""";
    private string _extractPurpose = "Post this invoice to accounts payable.";
    private string _fields = """
        [
          {"id":"invoice_id","pattern":"INV-\\d{4}-\\d{4}","description":"Official invoice number in the header"},
          {"id":"total_due","pattern":"USD [0-9,]+\\.[0-9]{2}","description":"Final amount the customer must pay (not subtotal, tax line, or budget notes)"},
          {"id":"billing_email","pattern":"[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}","description":"Billing contact email"},
          {"id":"payment_ref","pattern":"REF-[A-Z0-9-]+","description":"Payment reference code for remittance"}
        ]
        """;
    private string _request = "Add a logout button.";
    private string _diff = "--- a/ui\n+++ b/ui\n@@\n+Logout\n";
    private string _tests = "";

    private async Task RunAsync()
    {
        _busy = true;
        try
        {
            var auth = await Auth.GetAuthenticationStateAsync();
            _outcome = await PlaygroundRun.ExecuteAsync(CallAudit, auth.User, _tool, ExecuteToolAsync);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string> ExecuteToolAsync()
    {
        return _tool switch
        {
            JevTools.Screen => JevJson.Serialize(await Screen.JudgeAsync(new ScreenRequest(
                _text, EmptyToNull(_purpose), _blockAt, _reviewAt))),
            JevTools.Verify => JevJson.Serialize(await Verify.JudgeAsync(new VerifyRequest(
                PlaygroundJson.Lines(_claims),
                EvidenceInput.Parse(PlaygroundJson.ParseEvidence(_evidence)),
                _autoAccept))),
            JevTools.Find => JevJson.Serialize(await Find.JudgeAsync(new FindRequest(
                _query, PlaygroundJson.Items(_candidates, "candidates"), _topK))),
            JevTools.Rerank => JevJson.Serialize(await Rerank.JudgeAsync(new RerankRequest(
                _query, PlaygroundJson.Items(_candidates, "candidates"), _topK))),
            JevTools.Classify => JevJson.Serialize(await Classify.JudgeAsync(new ClassifyRequest(
                PlaygroundJson.Items(_items, "items"),
                PlaygroundJson.Classes(_classes),
                EmptyToNull(_purpose),
                Context: null,
                _autoAccept,
                _minimumMargin))),
            JevTools.Decide => JevJson.Serialize(await Decide.JudgeAsync(new DecideRequest(
                _decision,
                _evidenceText,
                _priorities,
                PlaygroundJson.Candidates(_decideCandidates),
                PlaygroundJson.Lines(_requirements) is { Count: > 0 } req ? req : null))),
            JevTools.Compare => JevJson.Serialize(await Compare.JudgeAsync(new CompareRequest(
                _passageA,
                _passageB,
                PlaygroundJson.Lines(_aspects) is { Count: > 0 } aspects ? aspects : null,
                EmptyToNull(_purpose),
                _autoAccept,
                _minimumMargin))),
            JevTools.Extract => JevJson.Serialize(await Extract.JudgeAsync(new ExtractRequest(
                _document,
                PlaygroundJson.Fields(_fields),
                EmptyToNull(_extractPurpose),
                _autoAccept,
                _minimumMargin))),
            JevTools.Review => JevJson.Serialize(await Review.JudgeAsync(new ReviewRequest(
                _request,
                _diff,
                EmptyToNull(_tests),
                _autoAccept,
                _reviewAt,
                _compositeFloor))),
            JevTools.Gate => JevJson.Serialize(await Gate.JudgeAsync(new GateRequest(
                _request,
                _diff,
                PlaygroundJson.Lines(_claims),
                EvidenceInput.Parse(PlaygroundJson.ParseEvidence(_evidence)),
                EmptyToNull(_tests),
                _autoAccept,
                _reviewAt,
                _compositeFloor))),
            _ => throw new InvalidOperationException($"Unknown tool {_tool}."),
        };
    }

    private static string? EmptyToNull(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
}
